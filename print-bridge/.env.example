SUPABASE_URL=https://frbziqazwhymwsrtneoy.supabase.co

# Chave pública (anon key) — apenas leitura nas views vw_print_bridge_*
SUPABASE_ANON_KEY=coloque_aqui_a_anon_key

# Nome do estabelecimento (aparece no topo do cupom)
ESTABLISHMENT_NAME=Meu Restaurante

# Porta do servidor HTTP local (para testes de impressora via painel do PDV)
BRIDGE_HTTP_PORT=7777

# ── Maquininha (TEF) ────────────────────────────────────────────────────────
# Vazio = esta instalação não atende a fila da maquininha, só imprime.
# simulado = aprova sozinho, para testar o caminho sem hardware.
TEF_PROVIDER=
TEF_HTTP_URL=
TEF_HTTP_TOKEN=
TEF_POLL_MS=2000
TEF_TIMEOUT_MS=120000
